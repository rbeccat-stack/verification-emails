# URL du webhook n8n. Lue uniquement côté serveur par /api/verify :
# pas de préfixe NEXT_PUBLIC_, elle n'est jamais envoyée au navigateur.
N8N_WEBHOOK_URL=https://ton-n8n.example.com/webhook/verification-emails

# Optionnel : clé envoyée dans l'en-tête X-Webhook-Key, à déclarer aussi en
# Header Auth sur le nœud Webhook de n8n.
N8N_WEBHOOK_KEY=

# Mot de passe demandé par le navigateur pour accéder à l'app (nom d'utilisateur libre).
APP_PASSWORD=
